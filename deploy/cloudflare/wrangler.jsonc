// Cloudflare deployment adapter for Five Minutes.
//
// Deploys the provider-neutral static build (`npm run build` -> dist/) with
// Workers Static Assets. The small Worker adapter handles only `/api/feedback`;
// lesson rendering and every other application route remain static. Nothing in
// src/ imports Cloudflare APIs. See deploy/cloudflare/README.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Deliberately distinct from any existing Five Minutes Worker/Pages project so
  // a deploy can never replace the current public site. Renaming is an Owner
  // decision.
  "name": "five-minutes-v2",
  "compatibility_date": "2026-10-02",
  "main": "worker.ts",
  // Runtime values are managed in the Cloudflare dashboard. Preserve them
  // across repository-driven deploys rather than replacing them from config.
  "keep_vars": true,
  "vars": {
    "FEEDBACK_GITHUB_REPOSITORY": "nunov00/five-minutes-feedback"
  },
  "assets": {
    // Relative to this file.
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    // Provider-neutral lesson paths are canonical without a trailing slash.
    // Astro still emits directory-style index.html files; Workers serves those
    // at the slash-less URL and redirects a trailing-slash request to it.
    "html_handling": "drop-trailing-slash"
  },
  // Serve on <name>.<account-subdomain>.workers.dev. No custom domain or
  // route is attached here. Branch/PR testing uses Worker Previews (below).
  "workers_dev": true,
  // Expose Worker Previews on workers.dev URLs. Wrangler 4.147.0 requires
  // this for `wrangler preview` deployments to have an active URL.
  "preview_urls": true,
  // Worker Previews (`wrangler preview`, used by `npm run cf:preview` for
  // branch/PR testing). Secrets are never committed here.
  "previews": {}
}
