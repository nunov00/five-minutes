---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title = 'Five Minutes', description = 'One worthwhile idea, made easy to discover, understand and explore.' } = Astro.props;
const pathname = Astro.url.pathname;
const navigation = [
  { href: '/', label: 'Today', current: pathname === '/' },
  { href: '/library', label: 'Library', current: pathname.startsWith('/library') },
  { href: '/topics', label: 'Topics', current: pathname.startsWith('/topics') },
  { href: '/search', label: 'Search', current: pathname.startsWith('/search') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Five Minutes" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15171a" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">Five Minutes</a>
        <nav class="site-nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="site-main container"><slot /></main>
  </body>
</html>
