---
import LessonBody from '../../components/reading/LessonBody.astro';
import { lessonArtwork } from '../../lib/figures/artwork.mjs';
import { lessonVisuals } from '../../lib/figures/collection.mjs';
import TeenActivity from '../../components/reading/TeenActivity.astro';
import { legacyPublicationDate } from '../../lib/editorial-order';
import LessonDates from '../../components/LessonDates.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { LoadedLesson } from '../../lib/content/loader';
import { getBuildContent } from '../../lib/content/build-content';
import { relatedLessons } from '../../lib/discovery/related';
import { lessonPath, type LessonEdition } from '../../lib/urls';

interface Props {
  lesson: LoadedLesson;
  edition: LessonEdition;
  editionPaths: Record<LessonEdition, string>;
}

export async function getStaticPaths() {
  const { metadata: { manifest, lessons }, getLesson } = await getBuildContent();
  const catalogueById = new Map(manifest.catalogue.map((entry) => [entry.id, entry]));

  return manifest.routes.map((route) => {
    const expectedPath = lessonPath(route.edition, route.slug);
    const astroPath = `/${route.edition}/${route.slug}`;
    if (route.path !== expectedPath || route.path !== astroPath) {
      throw new Error(`Manifest route disagrees with static route ownership: ${route.path}.`);
    }
    const lesson = getLesson(route.lessonId);
    const catalogueEntry = catalogueById.get(route.lessonId);
    if (!catalogueEntry) throw new Error(`Manifest route has no catalogue entry for ${route.lessonId}.`);
    const alternatePath = route.edition === 'adult' ? catalogueEntry.teen.path : catalogueEntry.adult.path;
    if (!alternatePath) throw new Error(`Missing alternate edition route for ${route.lessonId}.`);
    const editionPaths = { [route.edition]: route.path, [route.edition === 'adult' ? 'teen' : 'adult']: alternatePath } as Record<LessonEdition, string>;
    const related = relatedLessons(route.lessonId, lessons, route.edition);
    return {
      params: { edition: route.edition, slug: route.slug },
      props: { lesson, edition: route.edition, editionPaths, related },
    };
  });
}

const { lesson, edition, editionPaths, related } = Astro.props as Props & { related: ReturnType<typeof relatedLessons> };
const presentation = edition === 'adult' ? lesson.adult : lesson.teen;
const html = edition === 'adult' ? lesson.adultHtml : lesson.teenHtml;
if (!presentation) throw new Error(`Missing ${edition} presentation for ${lesson.metadata.id}.`);
const visuals=lessonVisuals(presentation);
const art=await lessonArtwork(lesson);
const lead=visuals.find(v=>v.role==='lead')?.figure;
const social={image:art.share,imageType:art.shareType,imageAlt:lead?.alt??'Five Minutes publication emblem.'};
---
<BaseLayout social={social} title={`${presentation.title} · Five Minutes`} description={presentation.description} edition={edition} editionPaths={editionPaths} wide={visuals.length>0}>
  <article class:list={['reading-article', {'has-figure': visuals.length>0}]} data-reader-lesson data-lesson-id={lesson.metadata.id} data-edition={edition}>
    <header class="reader-header">
      <p class="eyebrow"><LessonDates publishedAt={lesson.metadata.publishedAt} originalDate={legacyPublicationDate(lesson.metadata)} revisedAt={lesson.metadata.revisedAt} /></p>
      <h1>{presentation.title}</h1>
      <p class="lede">{presentation.description}</p>
    </header>
    {presentation.activity && <TeenActivity activity={presentation.activity} id={`activity-${lesson.metadata.id}`}/>}
    <LessonBody html={html} visuals={visuals} legacy={!!presentation.figure} id={`figure-${edition}-${lesson.metadata.id}`}/>
    <section class="card lesson-section recall-section" aria-labelledby="recall-heading" data-recall>
      <h2 id="recall-heading">Recall</h2>
      <p>{presentation.question}</p>
      <details data-recall-reveal>
        <summary><span class="reveal-marker" aria-hidden="true">▸</span>Reveal answer and takeaway</summary>
        <p class="answer">{presentation.answer}</p>
        <section aria-labelledby="takeaway-heading">
          <h3 id="takeaway-heading">Takeaway</h3>
          <p>{presentation.takeaway}</p>
        </section>
      </details>
    </section>
    <section class="lesson-section reader-actions" aria-label="Your reading">
      <button class="button button-secondary" type="button" data-save-lesson hidden>Save lesson</button>
      <button class="button button-secondary" type="button" data-read-lesson hidden>Mark unread</button>
      <p class="reader-js-fallback">Saving and read markers need JavaScript. The lesson itself remains fully readable.</p>
    </section>
    <section class="lesson-section" aria-labelledby="related-heading">
      <p class="eyebrow">Keep exploring</p>
      <h2 id="related-heading">Explore next</h2>
      <div class="related-list">
        {related.map((candidate) => (
          <article class="card related-card" data-related-id={candidate.id}>
            <h3><a href={candidate.path}>{candidate.title}</a></h3>
            <p>{candidate.reason}</p>
          </article>
        ))}
      </div>
    </section>
    <p class="lesson-section"><a data-return href="/">Back to home</a></p>
  </article>
</BaseLayout>
