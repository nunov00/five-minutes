---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { LoadedLesson } from '../../lib/content/loader';
import { getBuildContent } from '../../lib/content/build-content';
import { relatedLessons } from '../../lib/discovery/related';
import { EDITION_LABELS } from '../../lib/reading';
import { formatEditorialDate } from '../../lib/today';
import { lessonPath, type LessonEdition } from '../../lib/urls';

interface Props {
  lesson: LoadedLesson;
  edition: LessonEdition;
  editionPaths: Record<LessonEdition, string>;
}

export async function getStaticPaths() {
  const { metadata: { manifest, lessons }, getLesson } = await getBuildContent();
  const catalogueById = new Map(manifest.catalogue.map((entry) => [entry.id, entry]));

  return manifest.routes.map((route) => {
    const expectedPath = lessonPath(route.edition, route.slug);
    const astroPath = `/${route.edition}/${route.slug}`;
    if (route.path !== expectedPath || route.path !== astroPath) {
      throw new Error(`Manifest route disagrees with static route ownership: ${route.path}.`);
    }
    const lesson = getLesson(route.lessonId);
    const catalogueEntry = catalogueById.get(route.lessonId);
    if (!catalogueEntry) throw new Error(`Manifest route has no catalogue entry for ${route.lessonId}.`);
    const alternatePath = route.edition === 'adult' ? catalogueEntry.teen.path : catalogueEntry.adult.path;
    if (!alternatePath) throw new Error(`Missing alternate edition route for ${route.lessonId}.`);
    const editionPaths = { [route.edition]: route.path, [route.edition === 'adult' ? 'teen' : 'adult']: alternatePath } as Record<LessonEdition, string>;
    const related = relatedLessons(route.lessonId, lessons, route.edition);
    return {
      params: { edition: route.edition, slug: route.slug },
      props: { lesson, edition: route.edition, editionPaths, related },
    };
  });
}

const { lesson, edition, editionPaths, related } = Astro.props as Props & { related: ReturnType<typeof relatedLessons> };
const presentation = edition === 'adult' ? lesson.adult : lesson.teen;
const html = edition === 'adult' ? lesson.adultHtml : lesson.teenHtml;
if (!presentation) throw new Error(`Missing ${edition} presentation for ${lesson.metadata.id}.`);
---
<BaseLayout title={`${presentation.title} · ${EDITION_LABELS[edition]} edition · Five Minutes`} description={presentation.description} edition={edition} editionPaths={editionPaths}>
  <article data-lesson-id={lesson.metadata.id} data-edition={edition}>
    <header class="reader-header">
      <p class="eyebrow">{EDITION_LABELS[edition]} edition · <time datetime={lesson.metadata.publishedAt}>{formatEditorialDate(lesson.metadata.publishedAt)}</time></p>
      <h1>{presentation.title}</h1>
      <p class="lede">{presentation.description}</p>
    </header>
    <div class="lesson-body" set:html={html} />
    <section class="card lesson-section" aria-labelledby="takeaway-heading">
      <h2 id="takeaway-heading">Takeaway</h2>
      <p>{presentation.takeaway}</p>
    </section>
    <section class="card lesson-section" aria-labelledby="test-heading">
      <h2 id="test-heading">Test yourself</h2>
      <p>{presentation.question}</p>
      <details>
        <summary>Show answer</summary>
        <p class="answer">{presentation.answer}</p>
      </details>
    </section>
    <section class="lesson-section" aria-labelledby="related-heading">
      <p class="eyebrow">Keep exploring</p>
      <h2 id="related-heading">Explore next</h2>
      <div class="related-list">
        {related.map((candidate) => (
          <article class="card related-card" data-related-id={candidate.id}>
            <h3><a href={candidate.path}>{candidate.title}</a></h3>
            <p>{candidate.reason}</p>
          </article>
        ))}
      </div>
    </section>
    <p class="lesson-section"><a data-return href="/">Back to Today</a></p>
    <p class="lesson-section"><a class="other-version" href={editionPaths[edition==='adult'?'teen':'adult']}>Read the other version →</a></p>
  </article>
</BaseLayout>
