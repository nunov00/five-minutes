---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBuildMetadata } from '../../lib/content/build-content';
import { buildDiscoveryArtifacts } from '../../lib/discovery/artifacts';

const { lessons } = await getBuildMetadata();
const artifacts = buildDiscoveryArtifacts(lessons);
---
<BaseLayout title="Search · Five Minutes" description="Search Five Minutes lessons by idea, topic or takeaway.">
  <section aria-labelledby="search-heading">
    <p class="eyebrow">Discovery</p>
    <h1 id="search-heading">Search</h1>
    <p class="lede">Search titles, ideas, topics and takeaways. Article bodies stay out of the index.</p>

    <div class="search-panel" id="search-app" data-adult-index={artifacts.search.adult.path} data-teen-index={artifacts.search.teen.path}>
      <form class="search-form" role="search">
        <label for="lesson-query">What would you like to understand?</label>
        <div class="search-row">
          <input id="lesson-query" name="q" type="search" autocomplete="off" enterkeyhint="search" minlength="2" required />
          <button class="button" type="submit">Search</button>
        </div>
        <fieldset class="edition-options">
          <legend>Edition</legend>
          <label><input type="radio" name="edition" value="adult" /> Adult</label>
          <label><input type="radio" name="edition" value="teen" /> Teen</label>
        </fieldset>
      </form>
      <p class="search-status" role="status" aria-live="polite">Enter at least two characters to search.</p>
      <ol class="search-results" aria-label="Search results"></ol>
      <noscript><p>Search needs JavaScript. You can still browse every lesson in the <a href="/library">Library</a>.</p></noscript>
    </div>
  </section>
</BaseLayout>

<script>
  import { readerStorage, isEdition } from '../../lib/reader/state';
  import { searchDocuments } from '../../lib/discovery/search';
  import type { LessonEdition } from '../../lib/urls';
  import type { SearchDocument } from '../../lib/discovery/types';

  const app = document.querySelector<HTMLElement>('#search-app');
  const form = app?.querySelector<HTMLFormElement>('form');
  const input = app?.querySelector<HTMLInputElement>('#lesson-query');
  const status = app?.querySelector<HTMLElement>('.search-status');
  const list = app?.querySelector<HTMLOListElement>('.search-results');
  const indexes: Partial<Record<LessonEdition, Promise<SearchDocument[]>>> = {};
  let timer: number | undefined;
  let searchSequence = 0;

  function selectedEdition(): LessonEdition | null {
    const value=form?.querySelector<HTMLInputElement>('input[name="edition"]:checked')?.value;
    return isEdition(value)?value:null;
  }
  function context(writeUrl=true) {
    const edition=selectedEdition(), url=new URL(location.href);
    if(writeUrl){
      if(input?.value)url.searchParams.set('q',input.value);else url.searchParams.delete('q');
      if(edition)url.searchParams.set('edition',edition);else url.searchParams.delete('edition');
      history.replaceState(null,'',url.pathname+url.search+url.hash);
    }
    document.documentElement.dataset.edition=edition??'';
    document.querySelectorAll<HTMLAnchorElement>('[data-global-selector] a').forEach(link=>{
      const target=new URL(location.href);target.searchParams.set('edition',link.dataset.editionChoice!);
      link.href=target.pathname+target.search+target.hash;
      if(link.dataset.editionChoice===edition)link.setAttribute('aria-current','page');else link.removeAttribute('aria-current');
    });
    document.dispatchEvent(new Event('search-context'));
  }
  function initialise() {
    const url=new URL(location.href), value=url.searchParams.get('edition');
    const edition=isEdition(value)?value:readerStorage(()=>localStorage).read()?.edition;
    form?.querySelectorAll<HTMLInputElement>('input[name="edition"]').forEach(r=>{r.checked=r.value===edition;});
    if(input)input.value=url.searchParams.get('q')??'';
    context(false);void runSearch();
  }

  async function documents(edition: LessonEdition): Promise<SearchDocument[]> {
    if (!app) return [];
    const path = edition === 'teen' ? app.dataset.teenIndex : app.dataset.adultIndex;
    if (!path) throw new Error(`Missing ${edition} search index path.`);
    if (indexes[edition]) return indexes[edition];
    const request = fetch(path).then((response) => {
      if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
      return response.json() as Promise<SearchDocument[]>;
    });
    indexes[edition] = request;
    try {
      return await request;
    } catch (error) {
      if (indexes[edition] === request) delete indexes[edition];
      throw error;
    }
  }

  function appendResult(result: SearchDocument) {
    if (!list) return;
    const li = window.document.createElement('li');
    li.className = 'card search-result';
    const meta = window.document.createElement('p');
    meta.className = 'eyebrow';
    meta.textContent = `${result.topicLabel} · ${result.subtopicLabel}`;
    const heading = window.document.createElement('h2');
    const link = window.document.createElement('a');
    link.href = result.path;
    link.textContent = result.title;
    heading.append(link);
    const description = window.document.createElement('p');
    description.textContent = result.description;
    li.append(meta, heading, description);
    list.append(li);
  }

  async function runSearch() {
    if (!input || !status || !list) return;
    const sequence = ++searchSequence;
    const query = input.value.trim();
    const edition = selectedEdition();
    list.replaceChildren();
    if (!edition) { status.textContent = 'Choose Adult or Teen to search.'; return; }
    if (query.length < 2) { status.textContent = 'Enter at least two characters to search.'; return; }
    status.textContent = 'Searching…';
    try {
      const results = searchDocuments(await documents(edition), query);
      if (sequence !== searchSequence) return;
      results.forEach(({ document }) => appendResult(document));
      status.textContent = results.length === 0
        ? `No lessons found for “${query}”. Try a broader idea or browse the Library.`
        : `${results.length} ${results.length === 1 ? 'lesson' : 'lessons'} found.`;
    } catch {
      if (sequence !== searchSequence) return;
      status.textContent = 'Search could not load. Browse the Library and try again later.';
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(timer);
    context();void runSearch();
  });
  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    context();timer = window.setTimeout(() => void runSearch(), 180);
  });
  form?.addEventListener('change', () => {
    window.clearTimeout(timer);context();
    void runSearch();
  });
  window.addEventListener('pageshow',initialise);
  window.addEventListener('popstate',initialise);
  initialise();
</script>
