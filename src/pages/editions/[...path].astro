---
import LegacyRedirect from '../../components/LegacyRedirect.astro';
import { getBuildMetadata } from '../../lib/content/build-content';
import { discoveryPagePaths } from '../../lib/discovery/catalogue';
export async function getStaticPaths(){
 const {lessons}=await getBuildMetadata();
 return discoveryPagePaths(lessons).filter(path=>path.startsWith('/library')||path.startsWith('/topics')).flatMap(target=>['adult','teen'].map(edition=>({params:{path:`${edition}${target}`},props:{target}})));
}

---
<LegacyRedirect target={Astro.props.target}/>
