---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Chooser from '../../../components/discovery/Chooser.astro';
import { getBuildMetadata } from '../../../lib/content/build-content';
import { libraryPages } from '../../../lib/discovery/catalogue';
export async function getStaticPaths(){const {lessons}=await getBuildMetadata();return libraryPages(lessons).slice(1).map((_,i)=>({params:{page:String(i+2)}}));}
---
<BaseLayout title={`Library · Page ${Astro.params.page} · Five Minutes`} neutralDiscovery><Chooser path={Astro.url.pathname} title="Library"/></BaseLayout>
