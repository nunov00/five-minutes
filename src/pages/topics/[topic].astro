---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chooser from '../../components/discovery/Chooser.astro';
import { getBuildMetadata } from '../../lib/content/build-content';
import { TAXONOMY } from '../../lib/taxonomy';
export async function getStaticPaths(){const {lessons}=await getBuildMetadata();return TAXONOMY.filter(t=>lessons.some(l=>l.metadata.topic===t.token)).map(topic=>({params:{topic:topic.token},props:{topic}}));}
const {topic}=Astro.props;
---
<BaseLayout title={`${topic.label} · Topics · Five Minutes`} neutralDiscovery><Chooser path={Astro.url.pathname} title={topic.label}/></BaseLayout>
