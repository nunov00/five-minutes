---
import LessonFigure from './LessonFigure.astro';
import { positionVisuals } from '../../lib/figures/placement';
import type { LessonVisual } from '../../lib/content/presentation-extensions';
interface Props {html:string;visuals:LessonVisual[];id:string;legacy?:boolean;}
const {html,visuals,id,legacy=false}=Astro.props;
const parts=positionVisuals(html,visuals);
---
<div class={legacy?'reading-with-figure':'visual-sequence'}>
  {parts.map((part,index)=><>
    <div class:list={['lesson-body',{'figure-opening':legacy&&index===0,'figure-rest':legacy&&index>0}]} set:html={part.html}/>
    {part.visuals.map(visual=><LessonFigure figure={visual.figure} id={`${id}-${visual.id}`} eager={visual.role==='lead'&&(visual.figure.afterParagraph??1)===1}/>)}
  </>)}
</div>
