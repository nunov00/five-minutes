---
import type { LessonFigure } from '../../lib/content/presentation-extensions';
import { FIGURE_SYMBOLS } from '../../lib/figures/toolkit-contract.mjs';
interface Props { figure: LessonFigure; id: string; }
const {figure,id}=Astro.props;
const nodes=figure.type==='concept-flow'?figure.data.nodes:[];
const pattern=figure.type==='concept-flow'?figure.data.pattern:'';
const items=figure.type==='comparison-bars'?figure.data.items:[];
const maximum=Math.max(...items.map(item=>item.value))||1;
const cycleNodes=nodes.map((node,index)=>({node,index,x:150+100*Math.sin(2*Math.PI*index/nodes.length),y:150-100*Math.cos(2*Math.PI*index/nodes.length)}));
---
{figure.type==='orbital-motion' ? <div class="toolkit-figure orbit-mechanism" role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
 <svg viewBox="0 0 360 270" aria-hidden="true" focusable="false" data-visual-canvas>
  <defs>
   <marker id={`${id}-orbit-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 10 5 0 10Z" class="motion-arrowhead"/></marker>
   <marker id={`${id}-gravity-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 10 5 0 10Z" class="gravity-arrowhead"/></marker>
  </defs>
  <circle cx="180" cy="145" r="108" class="orbit-track"/>
  <circle cx="180" cy="145" r="58" class="orbit-earth"/>
  <path d="M135 130q30-30 45 5t55 15M170 93q-20 30 0 45t0 60" class="orbit-land"/>
  <text x="180" y="151" text-anchor="middle" data-visual-label>Earth</text>
  <path d="M214 37H278" class="motion-vector" marker-end={`url(#${id}-orbit-arrow)`}/>
  <path d="M180 53V83" class="gravity-vector" marker-end={`url(#${id}-gravity-arrow)`}/>
  <g class="orbit-station"><rect x="172" y="30" width="16" height="14" rx="3"/><path d="M170 32h-20v10h20M190 32h20v10h-20"/></g>
  <g class="orbit-badge" data-visual-label><circle cx="301" cy="37" r="12"/><text x="301" y="42" text-anchor="middle">1</text></g>
  <g class="orbit-badge" data-visual-label><circle cx="208" cy="70" r="12"/><text x="208" y="75" text-anchor="middle">2</text></g>
 </svg>
 <ol class="orbit-key" aria-hidden="true"><li data-visual-label><b>1 · Sideways motion</b><span>The path keeps curving around Earth.</span></li><li data-visual-label><b>2 · Gravity</b><span>Pulls towards Earth's centre.</span></li></ol>
 <p class="cabin-heading" aria-hidden="true">Inside: everything falls together</p>
 <svg class="free-fall-cabin" viewBox="0 0 360 142" aria-hidden="true" focusable="false">
  <rect x="32" y="8" width="296" height="84" rx="12" class="cabin-frame"/>
  <g class="cabin-objects"><circle cx="110" cy="33" r="8"/><path d="M110 41v20m-16-13 16-5 16 5m-26 26 10-13 10 13M220 37l25 12-4 7-25-12Z"/></g>
  {[{x:55,y:96},{x:110,y:82},{x:235,y:76}].map(({x,y})=><path d={`M${x} ${y}v26`} class="gravity-vector" marker-end={`url(#${id}-gravity-arrow)`}/>)}
 </svg>
 <p class="toolkit-note" aria-hidden="true">Station, astronaut and pencil share the fall. Schematic, not to scale; arrows show gravity.</p>
 </div> : figure.type==='concept-flow' && pattern==='cycle' ? <div class="toolkit-figure concept-cycle" role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
 <svg viewBox="0 0 300 300" aria-hidden="true" focusable="false" class="concept-cycle-ring" data-visual-canvas>
  <circle cx="150" cy="150" r="100" class="concept-ring-track"/>
  {cycleNodes.map(({node,index,x,y})=> <g>
   <circle cx={x} cy={y} r="29" class="concept-ring-disc"/>
   <path d={FIGURE_SYMBOLS[node.symbol]} transform={`translate(${x-20} ${y-20}) scale(.625)`} class="concept-ring-symbol"/>
   <g class="orbit-badge" data-visual-label><circle cx={x+27} cy={y-18} r="10"/><text x={x+27} y={y-14} text-anchor="middle">{index+1}</text></g>
  </g>)}
  {cycleNodes.map(({index})=>{
   const a=2*Math.PI*(index+.5)/nodes.length,x=150+100*Math.sin(a),y=150-100*Math.cos(a);
   return <path d="M-5-7 5 0-5 7" transform={`translate(${x} ${y}) rotate(${360*(index+.5)/nodes.length})`} class="concept-ring-arrow"/>;
  })}
 </svg>
 <ol class="concept-cycle-legend" aria-hidden="true">{nodes.map((node,index)=><li data-visual-label><b>{index+1}</b><span data-visual-copy>{node.label}</span></li>)}</ol>
 <p class="toolkit-note" aria-hidden="true">The final stage feeds back into the first.</p>
 </div> : figure.type==='concept-flow' ? <div class={`toolkit-figure concept-${pattern}`} role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
 <ol class="concept-nodes" aria-hidden="true">
  {nodes.map((node,index)=><li class="concept-node" data-visual-label>
   <span class="concept-symbol"><svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d={FIGURE_SYMBOLS[node.symbol]}/></svg></span>
   <strong data-visual-copy>{node.label}</strong>
   {pattern==='sequence' && index<nodes.length-1 && <span class="concept-arrow" aria-hidden="true">↓</span>}
  </li>)}
 </ol>
 </div> : figure.type==='comparison-bars' && <div class="toolkit-figure proportional-bars" role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
 <ol aria-hidden="true">{items.map(item=><li data-visual-label>
  <div class="bar-copy"><strong data-visual-copy>{item.label}</strong><span data-visual-copy>{item.display}</span></div>
  <div class="proportional-track"><span style={`width:${100*item.value/maximum}%`}></span></div>
 </li>)}</ol>
 <p class="toolkit-note" aria-hidden="true">{figure.data.unit ? `${figure.data.unit}. ` : ''}All bars start at zero and share one scale.</p>
 </div>}
