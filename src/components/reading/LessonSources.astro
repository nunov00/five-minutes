---
import type { LessonSource } from '../../lib/content/schema';
interface Props { sources: LessonSource[]; }
const { sources } = Astro.props;
---
{sources.length > 0 && <section class="lesson-section lesson-sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">Sources</h2>
  <ol>
    {sources.map((source, index) => <li id={`source-${index + 1}`} tabindex="-1">
      <a href={source.url} rel="noopener noreferrer">{source.title}</a>
      <span class="source-publication"> · {source.publisher}</span>
    </li>)}
  </ol>
</section>}
