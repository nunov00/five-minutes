---
import type { LessonFigure } from '../../lib/content/presentation-extensions';
interface Props { figure: LessonFigure; id: string; }
const {figure,id}=Astro.props;
const tilt=figure.type==='seasons-orbit'?figure.data.tiltDegrees:0;
const angle=tilt*Math.PI/180;
const axes=(cx:number)=>({northX:cx+56*Math.sin(angle),southX:cx-56*Math.sin(angle),northY:92-56*Math.cos(angle),southY:92+56*Math.cos(angle)});
const panels=[{key:'june',month:'June',earth:78,sun:242,hemisphere:'North'},{key:'december',month:'December',earth:222,sun:58,hemisphere:'South'}];
const flow=figure.type==='process-flow'||figure.type==='cycle-flow'?figure.data.steps:[];
const bars=figure.type==='comparison-bars'?figure.data.items:[];
const visualStyle=figure.type==='process-flow'||figure.type==='cycle-flow'||figure.type==='comparison-bars'?figure.data.style:'';
const cycleCentre=visualStyle==='heat-transfer'?'Heat moves':visualStyle==='feedback-loop'?'Check · adjust':'';
---
<figure class="lesson-figure" data-figure-type={figure.type} data-figure-style={visualStyle||undefined} aria-labelledby={`${id}-caption`}>
 {figure.type==='image' ? <img src={figure.src} width={figure.width} height={figure.height} alt={figure.alt} loading="lazy" decoding="async"/> : figure.type==='seasons-orbit' ? <>
  <div class="season-panels" role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
   {panels.map(panel=>{
    const axis=axes(panel.earth);
    return <svg viewBox="0 0 320 218" aria-hidden="true" focusable="false">
     <text x="14" y="24" class="diagram-month">{panel.month}</text>
     <circle cx={panel.sun} cy="92" r="26" class="diagram-sun"/>
     <text x={panel.sun} y="144" text-anchor="middle">Sun</text>
     <path d={panel.key==='june'?'M201 73H145 M201 92H145 M201 111H145':'M99 73H155 M99 92H155 M99 111H155'} class="diagram-ray"/>
     <path d={panel.key==='june'?'M149 69L143 73L149 77 M149 88L143 92L149 96 M149 107L143 111L149 115':'M151 69L157 73L151 77 M151 88L157 92L151 96 M151 107L157 111L151 115'} class="diagram-ray"/>
     <circle cx={panel.earth} cy="92" r="44" class="diagram-earth"/>
     <path d={`M${axis.southX} ${axis.southY}L${axis.northX} ${axis.northY}`} class="diagram-axis"/>
     <path d={`M${panel.earth-44*Math.cos(angle)} ${92-44*Math.sin(angle)}L${panel.earth+44*Math.cos(angle)} ${92+44*Math.sin(angle)}`} class="diagram-equator"/>
     <text x={axis.northX+5} y={axis.northY}>N</text><text x={axis.southX-15} y={axis.southY+10}>S</text>
     <text x="14" y="181">{panel.hemisphere}: longer days</text>
     <text x="14" y="204">More direct sunlight</text>
    </svg>;
   })}
  </div>
  <p class="diagram-key">Axis tilt: about {tilt}°. N = north; S = south. Schematic, not to scale.</p>
 </> : figure.type==='process-flow' ? <div class:list={["structured-figure","process-flow",`visual-${visualStyle}`]} role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
  <div class="filter-illustration" data-visual-canvas aria-hidden="true">
   <svg viewBox="0 0 360 250" focusable="false">
    <defs>
     <marker id={`${id}-flow-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="12" markerHeight="12" orient="auto"><path d="M0 0l10 5-10 5z" /></marker>
     <marker id={`${id}-return-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path d="M0 0l10 5-10 5z" /></marker>
     <marker id={`${id}-waste-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path d="M0 0l10 5-10 5z" /></marker>
    </defs>
    <text data-visual-label x="18" y="19">BLOOD FILTER</text><text data-visual-label x="252" y="19">TUBULE</text>
    <text data-visual-label x="18" y="237">BLOODSTREAM</text><text data-visual-label x="300" y="244">URINE</text>
    <path class="nephron-capsule" d="M39 77c0-36 29-55 64-55 38 0 67 24 67 59 0 31-23 53-54 59" />
    <path class="nephron-glomerulus" d="M18 73c26-7 29-35 61-31 31 4 48 28 35 48-11 18-42 15-42-6 0-15 21-21 31-10" />
    <path class="nephron-tubule" marker-end={`url(#${id}-flow-arrow)`} d="M116 140c46 2 51-35 93-35 37 0 54 27 40 50-17 28-72 8-80 40-7 26 42 27 83 22 31-4 51 1 73 0" />
    <path class="nephron-bloodstream" d="M20 211c51-40 105-27 145-5 48 26 91 21 141-15" />
    <path class="return-path return-path-one" marker-end={`url(#${id}-return-arrow)`} d="M207 124c-9 30-23 48-48 72" />
    <path class="return-path return-path-two" marker-end={`url(#${id}-return-arrow)`} d="M226 173c2 17-5 28-18 38" />
    <path class="waste-path" marker-end={`url(#${id}-waste-arrow)`} d="M271 194c-12-12-20-23-23-36" />
    <g data-visual-label class="figure-stage figure-stage-1"><circle cx="58" cy="111" r="15"/><text x="58" y="116">1</text></g>
    <g data-visual-label class="figure-stage figure-stage-2"><circle cx="180" cy="151" r="15"/><text x="180" y="156">2</text></g>
    <g data-visual-label class="figure-stage figure-stage-3"><circle cx="274" cy="169" r="15"/><text x="274" y="174">3</text></g>
    <path class="stage-leader" d="M326 200v12" />
    <g data-visual-label class="figure-stage figure-stage-4"><circle cx="326" cy="184" r="15"/><text x="326" y="189">4</text></g>
   </svg>
  </div>
  <ol class="filter-legend" aria-hidden="true">
   {flow.map((step,index)=><li data-visual-label data-visual-copy class={`filter-step filter-step-${index+1}`}>
    <span class="visual-number">{index+1}</span>
    <strong>{step.label}</strong>
   </li>)}
  </ol>
 </div> : figure.type==='cycle-flow' ? <div class:list={["structured-figure","cycle-flow",`visual-${visualStyle}`]} role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
  <div class="cycle-canvas" data-visual-canvas aria-hidden="true">
   <svg class="cycle-track" viewBox="0 0 300 300" focusable="false">
    <circle cx="150" cy="150" r="100" pathLength="100" />
    <path d="M145 45l12 5-9 9M255 145l-5 12-9-9M155 255l-12-5 9-9M45 155l5-12 9 9" />
   </svg>
   <span class="cycle-centre">{cycleCentre}</span>
   <ol>
    {flow.map((step,index)=><li data-visual-label data-visual-copy class={`cycle-step cycle-step-${index+1}`}>
     <span class="visual-number">{index+1}</span><strong>{step.label}</strong>
    </li>)}
   </ol>
  </div>
 </div> : <div class:list={["structured-figure","comparison-bars",`visual-${visualStyle}`]} role="img" aria-label={figure.alt} aria-describedby={`${id}-description`}>
  <ol class="growth-map" data-visual-canvas aria-hidden="true">
   {bars.map((item,index)=><li data-visual-label data-visual-copy style={`--growth-stage:${index}`}>
    <span class="growth-label">{item.label}</span><strong>{item.display}</strong>
    {index<bars.length-1&&<span class="growth-arrow">↗</span>}
   </li>)}
  </ol>
  {figure.data.unit&&<p class="growth-unit" aria-hidden="true">{figure.data.unit}</p>}
 </div>}
 <figcaption id={`${id}-caption`}>{figure.caption}</figcaption>
 <details class="figure-description"><summary>Explanation of this figure</summary><p id={`${id}-description`}>{figure.description}</p></details>
</figure>
