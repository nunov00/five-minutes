---
import { formatEditorialDate } from '../lib/today';
import { editorialTimestamp } from '../lib/editorial-order';
interface Props { publishedAt: string; archiveDate?: string; revisedAt?: string; }
const { publishedAt, archiveDate, revisedAt } = Astro.props;
const original = editorialTimestamp({ publishedAt, archiveDate });
---
<time datetime={original}>{formatEditorialDate(original)}</time>{revisedAt && <> · Revised on <time datetime={revisedAt}>{formatEditorialDate(revisedAt)}</time></>}
