---
import { legacyPublicationDate } from '../lib/editorial-order';
import LessonDates from './LessonDates.astro';
import type { LessonBundle } from '../lib/content/schema';
import { taxonomySubtopic, taxonomyTopic } from '../lib/taxonomy';
import { lessonPath, type LessonEdition } from '../lib/urls';

interface Props { lesson: LessonBundle; edition: LessonEdition; }
const { lesson, edition } = Astro.props as Props;
if (!lesson.adult || !lesson.teen) throw new Error(`Cannot render incomplete library lesson ${lesson.metadata.id}.`);
const presentation = lesson[edition];
if(!presentation)throw new Error(`Missing ${edition} presentation.`);
const topic = taxonomyTopic(lesson.metadata.topic);
const subtopic = taxonomySubtopic(lesson.metadata.topic, lesson.metadata.subtopic);
if (!topic || !subtopic) throw new Error(`Cannot render unknown taxonomy for ${lesson.metadata.id}.`);
---
<article class="card lesson-card" data-lesson-id={lesson.metadata.id}>
  <p class="eyebrow">{topic.label} · {subtopic.label}</p>
  <h2><a href={lessonPath(edition, lesson.metadata.slug)}>{presentation.title}</a></h2>
  <p>{presentation.description}</p>
  <div class="card-actions">
    <span><LessonDates publishedAt={lesson.metadata.publishedAt} originalDate={legacyPublicationDate(lesson.metadata)} revisedAt={lesson.metadata.revisedAt} /></span>
    <span class="reader-markers" data-reader-markers hidden></span>
  </div>
</article>
