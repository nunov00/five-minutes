{
  "name": "five-minutes-10k-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node benchmark/generate.mjs",
    "build": "astro build",
    "index": "node benchmark/index-minisearch.mjs",
    "measure": "node benchmark/measure.mjs",
    "benchmark": "npm run generate && /usr/bin/time -v npm run build && /usr/bin/time -v npm run index && npm run measure"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "astro": "5.14.1",
    "minisearch": "7.2.0"
  }
}
